rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function familyPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId);
    }
    function memberPath(familyId, uid) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(uid);
    }
    function isMember(familyId) {
      return signedIn() && exists(memberPath(familyId, request.auth.uid));
    }
    function isDad(familyId) {
      return isMember(familyId)
        && get(memberPath(familyId, request.auth.uid)).data.role == 'dad'
        && get(familyPath(familyId)).data.ownerUid == request.auth.uid;
    }
    function isSon(familyId) {
      return isMember(familyId)
        && get(memberPath(familyId, request.auth.uid)).data.role == 'son';
    }

    match /families/{familyId} {
      // Family code is a high-entropy invitation identifier; never publish it publicly.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isDad(familyId);

      match /members/{memberUid} {
        allow get: if signedIn()
          && (request.auth.uid == memberUid || isDad(familyId));
        allow list: if isDad(familyId);
        allow create: if signedIn() && request.auth.uid == memberUid
          && ((request.resource.data.role == 'dad'
                && get(familyPath(familyId)).data.ownerUid == request.auth.uid)
              || (request.resource.data.role == 'son'
                && exists(familyPath(familyId))));
        allow update, delete: if isDad(familyId);
      }

      match /spaces/{space}/state/{stateId} {
        allow get: if isMember(familyId) && stateId == 'main'
          && (space == 'production' || (space == 'test' && isDad(familyId)));
        allow list: if false;
        allow create, update, delete: if stateId == 'main' && (
          isDad(familyId)
          || (space == 'production' && isSon(familyId))
        );
      }
    }
  }
}
